[Unit]
Description=Pitta INMP441 audio detection
Wants=pitta-vision.service
Requires=pl_server.service
After=local-fs.target pl_server.service boot_leds.service pitta-vision.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/home/xilinx
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStartPre=/bin/sleep 30
ExecStart=/bin/bash /home/xilinx/start_pitta_audio.sh
Restart=always
RestartSec=20
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
