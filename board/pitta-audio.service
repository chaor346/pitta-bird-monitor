[Unit]
Description=Pitta INMP441 audio detection
Wants=pitta-vision.service
Requires=pl_server.service
After=local-fs.target pl_server.service boot_leds.service pitta-vision.service
# 2 分钟内失败 3 次即放弃，不再反复重载 Overlay（防止拖死板子）
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/home/xilinx
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
# 比视觉更晚启动，确保 boot_leds/pl_server/视觉 都已就绪
ExecStartPre=/bin/sleep 30
ExecStart=/bin/bash /home/xilinx/start_pitta_audio.sh
# 音频每 30 分钟(1800s)正常退出、需要 always 重开新会话；StartLimit 兜住崩溃循环
Restart=always
RestartSec=20
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
